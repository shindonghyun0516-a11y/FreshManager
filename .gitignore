# API 인증정보
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# macOS
.DS_Store
**/.DS_Store

# VS Code 개인설정
.vscode/

# 실제 수집 원본
data/raw/**
